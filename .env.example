# Shtemarm local development template — DO NOT put real secrets in this file.
# Copy to .env for local work; configure the same variables in Vercel/Lovable.
# The variables prefixed with VITE_ are EXPOSED to the browser at build time.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# OPTIONAL public APK hosted on your own static/CDN URL. This is browser-visible.
# Leave blank until the signed APK is cleared for distribution and publicly hosted.
# Example: VITE_ANDROID_APK_URL=https://shtemarm.am/downloads/shtemarm-android.apk
VITE_ANDROID_APK_URL=

# Server-side ONLY. Configure these in the deployment secret store.
# Never prefix secrets with VITE_ or include them in mobile assets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# AI costs are gated by Supabase reserve_ai_request() (apply migration first).
# Defaults: 15 requests/day per signed-in student, 20/day TOTAL for all guests,
# 80/day for admin bulk generation, 200/day site-wide, 15/minute site-wide.
AI_USER_DAILY_LIMIT=15
AI_GUEST_SHARED_DAILY_LIMIT=20
AI_ADMIN_DAILY_LIMIT=80
AI_GLOBAL_DAILY_LIMIT=200
AI_GLOBAL_MINUTE_LIMIT=15
# Optional secret pepper for stable one-way, account-ID usage buckets.
AI_QUOTA_SALT=
ADMIN_PASSWORD=

# Optional server-only database connection / authentication tokens:
DATABASE_URL=
# GITHUB_TOKEN=  (only if needed by trusted server code)
