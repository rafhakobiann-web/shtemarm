  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ugdkxmzvtjrcpylmpfjd.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "shtemarm",
      "version": "0.1.0",
      "title": "Shtemarm"
